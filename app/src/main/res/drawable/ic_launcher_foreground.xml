<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_launcher_background.xml
    Adaptive icon background layer — indigo-to-cyan brand gradient.
    Place in: res/drawable/ic_launcher_background.xml
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Gradient from center-top (#4F46E5 indigo) to bottom-right (#06B6D4 cyan).
        Using a radial-to-linear layered approach via two overlapping rects so
        the gradient always fills the full tile regardless of safe-zone crop.
    -->
    <path
        android:fillColor="#4F46E5"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- Cyan diagonal overlay — blends over the indigo base -->
    <path
        android:fillColor="#06B6D4"
        android:fillAlpha="0.55"
        android:pathData="M108,0 L108,108 L0,108 Z" />

    <!-- Violet mid-tone for depth in the center zone -->
    <path
        android:fillColor="#7C3AED"
        android:fillAlpha="0.30"
        android:pathData="M0,0 L108,0 L0,108 Z" />
</vector>